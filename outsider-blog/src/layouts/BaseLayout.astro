---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogImageAlt?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  reviewedBy?: string;
  schemaType?: 'NewsArticle' | 'BlogPosting' | 'Article' | 'LearningResource';
  noindex?: boolean;
}

const SITE = 'https://www.taooutsider.com';
const SITE_NAME = 'Tao Outsider';
const SITE_DESCRIPTION = 'Zoomed out on TAO Bittensor. Tracking every dTAO subnet. Mapping the future of decentralized AI.';
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const GOOGLE_ADS_ID = import.meta.env.PUBLIC_GOOGLE_ADS_ID || 'AW-11349197626';
const GTAG_IDS = Array.from(new Set([GA_MEASUREMENT_ID, GOOGLE_ADS_ID].filter(Boolean)));
const DEFAULT_GOOGLE_ADS_CONVERSION_LABELS: Record<string, string> = {
  lead_contact_click: 'JOQmCM_DvcAcELqG3KMq',
  newsletter_signup: 'jXFdCMnDvcAcELqG3KMq',
  field_school_start: 'vvOwCMzDvcAcELqG3KMq',
  article_view: '9kMYCJvgvcAcELqG3KMq',
  article_read: 'xvxLCJ7gvcAcELqG3KMq',
  purchase: 'ETldCKrOwsAcELqG3KMq',
};
const GOOGLE_ADS_CONVERSION_LABELS = Object.fromEntries(Object.entries({
  lead_contact_click: import.meta.env.PUBLIC_GOOGLE_ADS_LEAD_LABEL || DEFAULT_GOOGLE_ADS_CONVERSION_LABELS.lead_contact_click,
  newsletter_signup: import.meta.env.PUBLIC_GOOGLE_ADS_NEWSLETTER_LABEL || DEFAULT_GOOGLE_ADS_CONVERSION_LABELS.newsletter_signup,
  field_school_start: import.meta.env.PUBLIC_GOOGLE_ADS_FIELD_SCHOOL_START_LABEL || DEFAULT_GOOGLE_ADS_CONVERSION_LABELS.field_school_start,
  field_school_module_click: import.meta.env.PUBLIC_GOOGLE_ADS_FIELD_SCHOOL_MODULE_LABEL,
  field_school_quiz_submit: import.meta.env.PUBLIC_GOOGLE_ADS_FIELD_SCHOOL_QUIZ_LABEL,
  field_school_module_complete: import.meta.env.PUBLIC_GOOGLE_ADS_FIELD_SCHOOL_COMPLETE_LABEL,
  article_view: import.meta.env.PUBLIC_GOOGLE_ADS_ARTICLE_VIEW_LABEL || DEFAULT_GOOGLE_ADS_CONVERSION_LABELS.article_view,
  article_read: import.meta.env.PUBLIC_GOOGLE_ADS_ARTICLE_READ_LABEL || DEFAULT_GOOGLE_ADS_CONVERSION_LABELS.article_read,
  article_share: import.meta.env.PUBLIC_GOOGLE_ADS_ARTICLE_SHARE_LABEL,
  article_feedback: import.meta.env.PUBLIC_GOOGLE_ADS_ARTICLE_FEEDBACK_LABEL,
  purchase: import.meta.env.PUBLIC_GOOGLE_ADS_PURCHASE_LABEL || DEFAULT_GOOGLE_ADS_CONVERSION_LABELS.purchase,
}).filter(([, label]) => Boolean(label)));
const {
  title,
  description,
  canonicalURL = Astro.url.href,
  ogImage = '/og-default.jpg',
  ogImageAlt = 'Tao Outsider Bittensor Intelligence',
  article = false,
  pubDate,
  updatedDate,
  tags = [],
  author = SITE_NAME,
  reviewedBy,
  schemaType = 'Article',
  noindex = false,
} = Astro.props;

const fullTitle = title === SITE_NAME
  ? `${SITE_NAME} | Bittensor Intelligence`
  : `${title} | ${SITE_NAME}`;
const ogImageURL = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;
const feedURL = `${SITE}/rss.xml`;
const newsSitemapURL = `${SITE}/news-sitemap.xml`;

const articleSchema = article ? {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline: title,
  description,
  datePublished: pubDate?.toISOString(),
  dateModified: (updatedDate ?? pubDate)?.toISOString(),
  keywords: tags.join(', '),
  author: {
    '@type': author === SITE_NAME ? 'Organization' : 'Person',
    name: author,
    ...(author === SITE_NAME ? { url: SITE } : {}),
  },
  ...(reviewedBy ? { reviewedBy: { '@type': 'Organization', name: reviewedBy, url: SITE } } : {}),
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE,
    logo: { '@type': 'ImageObject', url: `${SITE}/logo.jpg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  image: ogImageURL,
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  ...(schemaType === 'LearningResource' ? {
    learningResourceType: 'Course module',
    educationalLevel: 'Beginner to intermediate',
    teaches: tags.length ? tags : ['Bittensor', 'TAO', 'dTAO', 'subnet research'],
    provider: {
      '@type': 'Organization',
      name: 'Bittensor Field College by Tao Outsider',
      url: `${SITE}/field-school/`,
    },
  } : {}),
} : null;

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE,
  description: SITE_DESCRIPTION,
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE,
  logo: `${SITE}/logo.jpg`,
  description: SITE_DESCRIPTION,
  sameAs: [
    'https://www.x.com/taooutsider',
  ],
};
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE_NAME} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="theme-color" content="#000000" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={feedURL} />
  <link rel="sitemap" type="application/xml" title={`${SITE_NAME} News Sitemap`} href={newsSitemapURL} />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Open Graph -->
  <meta property="og:type"        content={article ? 'article' : 'website'} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImageURL} />
  <meta property="og:image:alt"   content={ogImageAlt} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name"   content={SITE_NAME} />
  <meta property="og:locale"      content="en_US" />
  {article && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )}
  {article && updatedDate && (
    <meta property="article:modified_time" content={updatedDate.toISOString()} />
  )}
  {tags.map(t => <meta property="article:tag" content={t} />)}

  <!-- Twitter / X Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content="@taooutsider" />
  <meta name="twitter:creator"     content="@taooutsider" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageURL} />
  <meta name="twitter:image:alt"   content={ogImageAlt} />

  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  {articleSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  )}

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo.jpg" />

  {GTAG_IDS.length > 0 && (
    <>
      <script is:inline define:vars={{ gtagIds: GTAG_IDS, googleAdsId: GOOGLE_ADS_ID, googleAdsConversionLabels: GOOGLE_ADS_CONVERSION_LABELS }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){window.dataLayer.push(arguments);}

        const trackingIds = new Set(gtagIds);
        let gtagRequested = false;
        let gtagReady = false;

        const afterLoad = (callback, delay = 0) => {
          const run = () => window.setTimeout(callback, delay);
          if (document.readyState === 'complete') run();
          else window.addEventListener('load', run, { once: true });
        };

        const configureTrackingIds = () => {
          if (!gtagReady) return;
          window.gtag('js', new Date());
          trackingIds.forEach((id) => window.gtag('config', id));
        };

        const loadGtag = () => {
          if (gtagRequested || !trackingIds.size) return;
          gtagRequested = true;
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${Array.from(trackingIds)[0]}`;
          script.onload = () => {
            gtagReady = true;
            configureTrackingIds();
          };
          document.head.appendChild(script);
        };

        const cleanParams = (params) => {
          const clean = {};
          Object.entries(params || {}).forEach(([key, value]) => {
            if (value !== undefined && value !== null && value !== '') clean[key] = value;
          });
          return clean;
        };

        window.taoTrackConversion = function(eventName, params = {}) {
          if (!eventName || typeof window.gtag !== 'function') return;
          loadGtag();

          const eventParams = cleanParams({
            event_category: 'tao_outsider',
            page_path: window.location.pathname,
            ...params,
          });

          window.gtag('event', eventName, eventParams);

          const conversionLabel = googleAdsConversionLabels[eventName];
          if (googleAdsId && conversionLabel) {
            window.gtag('event', 'conversion', cleanParams({
              send_to: `${googleAdsId}/${conversionLabel}`,
              ...eventParams,
            }));
          }
        };

        const elementLabel = (element) => (
          element.dataset.conversionLabel
          || element.getAttribute('aria-label')
          || element.textContent?.trim().replace(/\s+/g, ' ').slice(0, 120)
          || document.title
        );

        const eventPayload = (element) => {
          const url = element.href || element.action;
          let outbound = false;
          try {
            outbound = Boolean(url && new URL(url, window.location.href).hostname !== window.location.hostname);
          } catch {
            outbound = false;
          }

          return cleanParams({
            event_category: element.dataset.conversionCategory || 'site_interaction',
            event_label: elementLabel(element),
            link_url: url,
            outbound,
          });
        };

        document.addEventListener('click', (event) => {
          const element = event.target instanceof Element
            ? event.target.closest('[data-conversion-event]')
            : null;
          if (!element) return;
          window.taoTrackConversion(element.dataset.conversionEvent, eventPayload(element));
        });

        document.addEventListener('submit', (event) => {
          const element = event.target instanceof Element
            ? event.target.closest('[data-conversion-event]')
            : null;
          if (!element) return;
          window.taoTrackConversion(element.dataset.conversionEvent, eventPayload(element));
        });

        const loadCloudflareBeacon = (token) => {
          if (!token || document.querySelector('script[data-cf-beacon]')) return;
          const beacon = document.createElement('script');
          beacon.defer = true;
          beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          beacon.dataset.cfBeacon = JSON.stringify({ token });
          document.head.appendChild(beacon);
        };

        const hydrateRuntimeTracking = () => {
          fetch('/api/tracking-config', { cache: 'no-store' })
            .then((response) => response.ok ? response.json() : null)
            .then((config) => {
            if (!config || typeof config !== 'object') return;

            if (config.gaMeasurementId && !gtagIds.includes(config.gaMeasurementId)) {
              trackingIds.add(config.gaMeasurementId);
              configureTrackingIds();
            }

            afterLoad(() => loadCloudflareBeacon(config.cloudflareWebAnalyticsToken), 9500);
            })
            .catch(() => {});
        };

        ['pointerdown', 'keydown', 'touchstart'].forEach((eventName) => {
          window.addEventListener(eventName, loadGtag, { once: true, passive: true });
        });
        afterLoad(hydrateRuntimeTracking, 1400);
        afterLoad(loadGtag, 9500);
      </script>
    </>
  )}

  <script is:inline define:vars={{ pageTitle: fullTitle, pageType: article ? 'article' : 'page' }}>
    (() => {
      const sendSiteEvent = (eventName) => {
        const payload = {
          eventName,
          path: window.location.pathname,
          pageTitle,
          pageType,
          referrer: document.referrer || '',
        };

        try {
          const body = JSON.stringify(payload);
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/site-event', new Blob([body], { type: 'application/json' }));
            return;
          }

          fetch('/api/site-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body,
            keepalive: true,
          }).catch(() => {});
        } catch {
          // Analytics must never block rendering.
        }
      };

      sendSiteEvent('page_view');

      if (pageType === 'article') {
        let sentRead = false;
        const markRead = () => {
          if (sentRead) return;
          const scrollDepth = window.scrollY + window.innerHeight;
          const threshold = Math.min(document.documentElement.scrollHeight * 0.65, 1600);
          if (scrollDepth >= threshold) {
            sentRead = true;
            sendSiteEvent('article_read');
            if (typeof window.taoTrackConversion === 'function') {
              window.taoTrackConversion('article_read', {
                event_category: 'content',
                event_label: pageTitle,
              });
            }
          }
        };

        window.addEventListener('scroll', markRead, { passive: true });
        window.setTimeout(markRead, 45000);
      }
    })();
  </script>

  <slot name="head" />
</head>
<body>
  <Nav />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</body>
</html>
