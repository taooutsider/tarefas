<section class="taoflows-live container" aria-labelledby="taoflows-live-heading" data-taoflows-live>
  <div class="flow-head">
    <div>
      <p class="flow-kicker">TaoFlows live</p>
      <h2 id="taoflows-live-heading">Liquidity flow</h2>
    </div>
    <a
      class="flow-button"
      href="https://taoflows.app/"
      target="_blank"
      rel="noopener"
      data-conversion-event="external_resource_click"
      data-conversion-category="ecosystem_data"
      data-conversion-label="Open TaoFlows"
    >Open TaoFlows</a>
  </div>

  <div class="flow-board" aria-label="Live TaoFlows liquidity pulse">
    <article class="flow-primary">
      <span class="live-label"><span class="live-dot" aria-hidden="true"></span>1H net flow</span>
      <strong data-flow="netVolume">Loading</strong>
      <small data-flow="netLabel">Reading live flow.</small>
    </article>

    <article class="flow-chart-card">
      <div class="flow-chart-head">
        <h3>Five minute buckets</h3>
        <span>Net buy/sell tape</span>
      </div>
      <div class="flow-bars" data-flow-bars aria-label="Five minute liquidity buckets"></div>
    </article>

    <div class="flow-stats">
      <div>
        <span>Buy volume</span>
        <strong data-flow="buyVolume">...</strong>
      </div>
      <div>
        <span>Sell volume</span>
        <strong data-flow="sellVolume">...</strong>
      </div>
      <div>
        <span>Active subnets</span>
        <strong data-flow="activeSubnets">...</strong>
      </div>
      <div>
        <span>Latest event</span>
        <strong data-flow="latestTransaction">...</strong>
      </div>
    </div>
  </div>

  <p class="flow-context" data-flow="context" aria-live="polite">Reading TaoFlows data.</p>
</section>

<script>
  const roots = document.querySelectorAll('[data-taoflows-live]');

  const compactNumber = (value, maximumFractionDigits = 1) => {
    const number = Number(value);
    if (!Number.isFinite(number)) return 'Unavailable';
    return number.toLocaleString('en-US', {
      notation: 'compact',
      maximumFractionDigits,
    });
  };

  const formatTao = (value, maximumFractionDigits = 1) => `${compactNumber(value, maximumFractionDigits)} TAO`;

  const setText = (root, key, value) => {
    const element = root.querySelector(`[data-flow="${key}"]`);
    if (element) element.textContent = value;
  };

  const renderBars = (root, bars) => {
    const wrap = root.querySelector('[data-flow-bars]');
    if (!wrap) return;
    wrap.innerHTML = '';
    if (!bars.length) {
      const empty = document.createElement('span');
      empty.className = 'flow-empty';
      empty.textContent = 'Waiting for flow buckets';
      wrap.append(empty);
      return;
    }
    const max = Math.max(...bars.map((bar) => Math.abs(Number(bar.netVolume) || 0)), 1);

    bars.forEach((bar) => {
      const item = document.createElement('span');
      const netVolume = Number(bar.netVolume) || 0;
      const magnitude = Math.max(10, (Math.abs(netVolume) / max) * 100);
      item.className = netVolume >= 0 ? 'flow-bar is-buy' : 'flow-bar is-sell';
      item.style.height = `${magnitude}%`;
      item.title = `${formatTao(Math.abs(netVolume), 2)} ${netVolume >= 0 ? 'net buy' : 'net sell'}`;
      wrap.append(item);
    });
  };

  const latestLabel = (latest) => {
    if (!latest) return 'Waiting';
    const amount = Number(latest.amountTao);
    const amountText = Number.isFinite(amount) && amount > 0.000001
      ? ` ${formatTao(amount, amount < 1 ? 3 : 2)}`
      : '';
    return `${latest.type} ${latest.subnet}${amountText}`;
  };

  const hydrateFlow = async (root) => {
    try {
      const response = await fetch('/api/taoflows-pulse');
      if (!response.ok) throw new Error('Flow request failed.');

      const data = await response.json();
      const overview = data.overview || {};
      const latest = data.latestTransaction;
      const net = Number(overview.netVolumeTao);

      setText(root, 'netVolume', Number.isFinite(net) ? `${net >= 0 ? '+' : ''}${formatTao(net, 2)}` : 'Unavailable');
      setText(root, 'netLabel', net >= 0 ? 'Net buy flow last 1H' : 'Net sell flow last 1H');
      setText(root, 'buyVolume', formatTao(overview.buyVolumeTao, 1));
      setText(root, 'sellVolume', formatTao(overview.sellVolumeTao, 1));
      setText(root, 'activeSubnets', compactNumber(overview.activeSubnets, 0));
      setText(root, 'latestTransaction', latestLabel(latest));
      setText(root, 'context', `${compactNumber(overview.totalTransactions, 0)} transactions last 1H. Latest block ${overview.latestBlock || 'pending'}. Source: ${data.source}.`);
      renderBars(root, data.bars || []);
      root.classList.toggle('is-sell', net < 0);
      root.classList.add('is-loaded');
    } catch {
      setText(root, 'netVolume', 'Paused');
      setText(root, 'netLabel', 'Live TaoFlows read is temporarily unavailable.');
      setText(root, 'buyVolume', 'Unavailable');
      setText(root, 'sellVolume', 'Unavailable');
      setText(root, 'activeSubnets', 'Unavailable');
      setText(root, 'latestTransaction', 'Open TaoFlows');
      renderBars(root, []);
      setText(root, 'context', 'TaoFlows pulse is unavailable right now.');
      root.classList.add('is-muted');
    }
  };

  const flowRefreshMs = 30 * 1000;

  const startFlowRefresh = (root) => {
    hydrateFlow(root);

    window.setInterval(() => {
      if (!document.hidden) hydrateFlow(root);
    }, flowRefreshMs);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) hydrateFlow(root);
    });
  };

  const startWhenUseful = (root) => {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        startFlowRefresh(root);
      }, { rootMargin: '420px 0px' });
      observer.observe(root);
      return;
    }

    const run = () => window.setTimeout(() => startFlowRefresh(root), 2600);
    if (document.readyState === 'complete') run();
    else window.addEventListener('load', run, { once: true });
  };

  roots.forEach(startWhenUseful);
</script>

