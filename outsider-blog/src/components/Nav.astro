---
import TaoMarketWidget from './TaoMarketWidget.astro';

const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  pathname === path || pathname.startsWith(path + '/');
---

<header class="nav-wrap">
  <nav class="container nav-inner" aria-label="Main navigation">

    <a href="/" class="logo" aria-label="Tao Outsider Home">
      <img src="/logo.svg" alt="Outsider" class="logo-img" width="140" height="28" decoding="async" />
    </a>

    <ul class="nav-links" role="list">
      <li><a href="/blog/"      class:list={['nav-link', { active: isActive('/blog') }]}>Blog</a></li>
      <li><a href="/subnet-research/" class:list={['nav-link', { active: isActive('/subnet-research') }]}>Subnet Research</a></li>
      <li><a href="/experimentao-wallet/" class:list={['nav-link', { active: isActive('/experimentao-wallet') }]}>ExperimenTAO</a></li>
      <li><a href="/field-school/" class:list={['nav-link', { active: isActive('/field-school') }]}>Field College</a></li>
      <li><a href="https://www.x.com/taooutsider" class="nav-link" rel="noopener" target="_blank" data-conversion-event="outbound_x_click" data-conversion-category="social" data-conversion-label="Nav X profile click">X - Tao Outsider</a></li>
    </ul>

    <div class="nav-right">
      <TaoMarketWidget />
    </div>

  </nav>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(0,0,0,0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .logo-img {
    height: 28px;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
  }
  .nav-link {
    font-size: 14px;
    color: #9a9a9a;
    padding: 5px 11px;
    border-radius: 5px;
    transition: color 0.12s, background 0.12s;
  }
  .nav-link:hover { color: var(--text); background: var(--s2); }
  .nav-link.active { color: var(--white); }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  @media (max-width: 940px) {
    .nav-inner {
      flex-wrap: wrap;
      gap: 8px 12px;
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .nav-links {
      order: 3;
      width: 100%;
      display: flex;
      gap: 4px;
      overflow-x: auto;
      padding: 4px 0 1px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .nav-links::-webkit-scrollbar {
      display: none;
    }
    .nav-link {
      white-space: nowrap;
      font-size: 13px;
      padding: 5px 9px;
      color: #a8a8a8;
    }
  }
</style>
