---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EcosystemPulse from '../components/EcosystemPulse.astro';
import TaoFlowsPulse from '../components/TaoFlowsPulse.astro';
import PostCard from '../components/PostCard.astro';
import { getImageDimensions, getOptimizedImage } from '../lib/optimized-images';
import { isPublishedPost, sortNewestPosts } from '../lib/posts';

const sorted = sortNewestPosts((await getCollection('blog')).filter(isPublishedPost));
const isFieldCollegePost = (post: typeof sorted[number]) => post.id.startsWith('bittensor-field-school');
const editorialPosts = sorted.filter(post => !isFieldCollegePost(post));
const featured = editorialPosts[0] ?? sorted[0];
const railPosts = editorialPosts.filter(p => p !== featured).slice(0, 5);
const recent = editorialPosts.filter(p => p !== featured).slice(0, 6);
const fieldCollegeEntry =
  sorted.find(post => post.id === 'bittensor-field-school-useful-work') ??
  sorted.find(isFieldCollegePost);

const featuredDate = featured?.data.pubDate.toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric',
});
const featuredOptimizedImage = getOptimizedImage(featured?.data.image, 'hero');
const featuredImageDimensions = getImageDimensions(featured?.data.image, 'hero');

const categoryLabel: Record<string, string> = {
  analysis: 'Analysis', subnet: 'Subnet Deep Dive',
  trade: 'Trade Setup', guide: 'Guide',
};
---

<BaseLayout
  title="Tao Outsider"
  description="Zoomed out on TAO Bittensor. Tracking every dTAO subnet. Mapping the future of decentralized AI."
>
  <section class="journal-cover container" aria-labelledby="journal-heading">
    <div class="journal-topline">
      <span>Tao Outsider Journal</span>
      <span>{editorialPosts.length} published articles</span>
    </div>

    <div class="journal-intro">
      <h1 id="journal-heading">Independent Bittensor intelligence.</h1>
      <p>Zoomed out on TAO Bittensor. Tracking every dTAO subnet. Mapping the future of decentralized AI.</p>
    </div>

    <div class="cover-grid">
      {featured && (
        <article class="cover-story" itemscope itemtype="https://schema.org/BlogPosting">
          <a href={`/blog/${featured.id}/`} class="cover-media" aria-label={featured.data.title}>
            {featured.data.image ? (
              <picture>
                {featuredOptimizedImage?.avif && <source srcset={featuredOptimizedImage.avif} type="image/avif" />}
                {featuredOptimizedImage?.webp && <source srcset={featuredOptimizedImage.webp} type="image/webp" />}
                <img
                  src={featuredOptimizedImage?.webp ?? featured.data.image}
                  alt=""
                  width={featuredImageDimensions.width}
                  height={featuredImageDimensions.height}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </picture>
            ) : (
              <span>Featured article</span>
            )}
          </a>
          <div class="cover-copy">
            <span class:list={['tag', `tag-${featured.data.category}`]}>
              {categoryLabel[featured.data.category] ?? featured.data.category}
            </span>
            <h2 itemprop="headline">
              <a href={`/blog/${featured.id}/`}>{featured.data.title}</a>
            </h2>
            <p itemprop="description">{featured.data.description}</p>
            <div class="cover-meta">
              <time datetime={featured.data.pubDate.toISOString()} itemprop="datePublished">
                {featuredDate}
              </time>
              {featured.data.tags.length > 0 && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{featured.data.tags.slice(0, 3).join(', ')}</span>
                </>
              )}
            </div>
            <a class="text-link" href={`/blog/${featured.id}/`}>Read article</a>
          </div>
        </article>
      )}

      <aside class="latest-rail" aria-label="Latest articles">
        <div class="rail-head">
          <h2>Latest articles</h2>
          <a href="/blog/">All articles</a>
        </div>
        <ol class="rail-list" role="list">
          {railPosts.map((p, i) => (
            <li>
              <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                <time datetime={p.data.pubDate.toISOString()}>
                  {p.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                </time>
              </div>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  {recent.length > 0 && (
    <section class="journal-feed container" aria-labelledby="recent-heading">
      <div class="section-header editorial-header">
        <div>
          <p>Journal desk</p>
          <h2 id="recent-heading">Articles, field notes and subnet research</h2>
        </div>
        <a href="/blog/">View all</a>
      </div>

      <nav class="cat-filter" aria-label="Filter by category">
        <a href="/blog/" class="cat-pill active">All</a>
        <a href="/blog/tag/analysis/" class="cat-pill">Analysis</a>
        <a href="/subnet-research/" class="cat-pill">Subnet Research</a>
        <a href="/field-school/" class="cat-pill">Field College</a>
      </nav>

      <div class="posts-grid" role="list">
        {recent.map(post => (
          <div role="listitem">
            <PostCard post={post} />
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="field-college-band container" aria-labelledby="field-college-home-heading">
    <div class="college-copy">
      <p>Bittensor Field College</p>
      <h2 id="field-college-home-heading">A free curriculum for people who want to investigate Bittensor for real.</h2>
      <p class="college-description">
        The college sits beside the journal. Articles explain what matters now. Field College teaches how to verify claims, read subnets, judge incentives and build your own thesis.
      </p>
      <div class="college-stats" aria-label="Bittensor Field College highlights">
        <span><strong>50</strong> modules</span>
        <span><strong>250</strong> quiz questions</span>
        <span><strong>1</strong> certificate path</span>
      </div>
      <div class="college-actions">
        <a href="/field-school/">Open curriculum</a>
        {fieldCollegeEntry && (
          <a href={`/blog/${fieldCollegeEntry.id}/`}>Start first lesson</a>
        )}
      </div>
    </div>
    <div class="college-map" aria-hidden="true">
      <span>01</span>
      <span>Useful work</span>
      <span>02</span>
      <span>Subnets</span>
      <span>03</span>
      <span>Markets</span>
      <span>04</span>
      <span>Thesis</span>
    </div>
  </section>

  <section class="data-desk-intro container" aria-labelledby="data-desk-heading">
    <p>Live data desk</p>
    <h2 id="data-desk-heading">Market context for readers, not noise before the article.</h2>
  </section>

  <EcosystemPulse />
  <TaoFlowsPulse />

  <section class="newsletter container" aria-labelledby="nl-heading">
    <div class="nl-inner">
      <h2 id="nl-heading">Free weekly Bittensor brief</h2>
      <p>The most important TAO developments every week, market moves, subnet changes, new alpha. No spam.</p>
      <form
        class="nl-form"
        method="POST"
        action="/api/subscribe"
        data-conversion-event="newsletter_signup"
        data-conversion-category="lead"
        data-conversion-label="Homepage newsletter signup"
      >
        <label for="nl-email" class="sr-only">Email address</label>
        <input type="email" id="nl-email" name="email" placeholder="your@email.com" required autocomplete="email" />
        <button type="submit">Subscribe &rarr;</button>
      </form>
    </div>
  </section>

</BaseLayout>

<style>
  .journal-cover {
    padding: 38px 24px 40px;
    max-width: 1120px;
  }
  .journal-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .journal-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(300px, 0.78fr);
    gap: 40px;
    align-items: end;
    padding: 28px 0 34px;
    border-bottom: 1px solid var(--border);
  }
  .journal-intro h1 {
    max-width: 820px;
    color: var(--white);
    font-size: clamp(2.55rem, 7.6vw, 5.25rem);
    line-height: 0.94;
    letter-spacing: -0.055em;
  }
  .journal-intro p {
    color: var(--text2);
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.65;
  }
  .cover-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(310px, 370px);
    gap: 38px;
    align-items: stretch;
    padding-top: 30px;
  }
  .cover-story {
    display: block;
    min-width: 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .cover-media {
    position: relative;
    display: block;
    aspect-ratio: 1200 / 630;
    min-height: 0;
    overflow: hidden;
    background:
      repeating-linear-gradient(0deg, transparent, transparent 35px, var(--border) 35px, var(--border) 36px),
      repeating-linear-gradient(90deg, transparent, transparent 35px, var(--border) 35px, var(--border) 36px),
      var(--s1);
  }
  .cover-media picture,
  .cover-media img {
    width: 100%;
    height: 100%;
  }
  .cover-media picture {
    display: block;
  }
  .cover-media img {
    display: block;
    object-fit: cover;
    filter: grayscale(0.06) contrast(1.08);
    transition: transform 0.45s ease, filter 0.2s ease;
  }
  .cover-media:hover img {
    transform: scale(1.025);
    filter: grayscale(0) contrast(1.08);
  }
  .cover-media span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .cover-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 24px 0 28px;
  }
  .cover-copy .tag {
    align-self: flex-start;
    margin-bottom: 16px;
  }
  .cover-copy h2 {
    max-width: 620px;
    color: var(--white);
    font-size: clamp(1.9rem, 3.8vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin-bottom: 18px;
    overflow-wrap: break-word;
  }
  .cover-copy h2 a {
    color: inherit;
    transition: color 0.12s;
  }
  .cover-copy h2 a:hover {
    color: var(--text2);
  }
  .cover-copy p {
    max-width: 650px;
    color: var(--text2);
    font-size: 1rem;
    line-height: 1.72;
    margin-bottom: 18px;
  }
  .cover-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 22px;
  }
  .text-link {
    align-self: flex-start;
    color: var(--white);
    font-size: 13px;
    font-weight: 800;
    border-bottom: 1px solid var(--border2);
    padding-bottom: 4px;
    transition: color 0.12s, border-color 0.12s;
  }
  .text-link:hover {
    color: var(--text2);
    border-color: var(--text2);
  }
  .latest-rail {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 18px 0;
  }
  .rail-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }
  .rail-head h2,
  .rail-head a {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .rail-head h2 {
    color: var(--muted);
  }
  .rail-head a {
    color: var(--text2);
    transition: color 0.12s;
  }
  .rail-head a:hover {
    color: var(--white);
  }
  .rail-list {
    list-style: none;
  }
  .rail-list li {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 14px;
    padding: 15px 0;
    border-top: 1px solid var(--border);
  }
  .rail-list li:first-child {
    border-top: none;
  }
  .rail-list li > span {
    color: var(--border2);
    font-family: var(--mono, monospace);
    font-size: 13px;
    font-weight: 800;
  }
  .rail-list a {
    display: block;
    color: var(--text);
    font-size: 15px;
    font-weight: 650;
    line-height: 1.35;
    transition: color 0.12s;
  }
  .rail-list a:hover {
    color: var(--white);
  }
  .rail-list time {
    display: block;
    color: var(--muted);
    font-size: 12px;
    margin-top: 7px;
  }
  .journal-feed {
    padding: 42px 24px 60px;
    max-width: 1120px;
  }
  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
    max-width: 1120px;
    margin-inline: auto;
  }
  .section-header p,
  .data-desk-intro p,
  .college-copy > p:not(.college-description) {
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .section-header h2,
  .data-desk-intro h2,
  .field-college-band h2 {
    color: var(--white);
    font-size: clamp(1.55rem, 3.2vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  .section-header a {
    color: var(--text2);
    font-size: 13px;
    font-weight: 800;
    transition: color 0.12s;
  }
  .section-header a:hover {
    color: var(--white);
  }
  .cat-filter {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 28px;
    max-width: 1120px;
    margin-inline: auto;
  }
  .cat-pill {
    font-size: 12px;
    font-weight: 500;
    padding: 5px 13px;
    border: 1px solid var(--border);
    border-radius: 20px;
    color: var(--muted);
    background: var(--s1);
    transition: all 0.12s;
  }
  .cat-pill:hover, .cat-pill.active {
    border-color: var(--border2);
    color: var(--text);
    background: var(--s2);
  }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    max-width: 1120px;
    margin: 0 auto;
  }
  .field-college-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 420px);
    gap: 36px;
    align-items: center;
    max-width: 1120px;
    padding: 52px 24px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(90deg, rgba(255,255,255,0.035), transparent 34%),
      repeating-linear-gradient(90deg, transparent, transparent 71px, rgba(255,255,255,0.025) 71px, rgba(255,255,255,0.025) 72px);
  }
  .college-description {
    max-width: 720px;
    color: var(--text2);
    font-size: 15px;
    line-height: 1.75;
    margin: 16px 0 24px;
  }
  .college-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    max-width: 620px;
    margin-bottom: 24px;
  }
  .college-stats span {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(0,0,0,0.32);
    color: var(--text2);
    font-size: 12px;
    line-height: 1.3;
    padding: 12px;
  }
  .college-stats strong {
    display: block;
    color: var(--white);
    font-size: 1.25rem;
    line-height: 1;
    margin-bottom: 5px;
  }
  .college-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .college-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border: 1px solid var(--border2);
    border-radius: 8px;
    padding: 0 16px;
    color: var(--text);
    font-size: 13px;
    font-weight: 800;
    transition: background 0.12s, color 0.12s, transform 0.12s;
  }
  .college-actions a:first-child {
    background: var(--white);
    color: #000;
  }
  .college-actions a:hover {
    transform: translateY(-1px);
  }
  .college-map {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    border-top: 1px solid var(--border);
    background: rgba(0,0,0,0.36);
  }
  .college-map span {
    min-width: 0;
    padding: 17px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 15px;
    font-weight: 750;
  }
  .college-map span:nth-child(odd) {
    color: var(--muted);
    font-family: var(--mono, monospace);
    font-size: 12px;
  }
  .data-desk-intro {
    max-width: 1120px;
    padding: 58px 24px 22px;
    border-top: 1px solid var(--border);
  }
  .data-desk-intro h2 {
    max-width: 680px;
  }
  .newsletter {
    padding: 10px 24px 80px;
  }
  .nl-inner {
    background: var(--s1);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 48px;
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .nl-inner h2 { font-size: 1.4rem; margin-bottom: 10px; }
  .nl-inner p { font-size: 14px; color: var(--text2); margin-bottom: 28px; }
  .nl-form { display: flex; gap: 10px; max-width: 400px; margin: 0 auto; }
  .nl-form input {
    flex: 1;
    background: var(--bg);
    border: 1px solid var(--border2);
    color: var(--text);
    padding: 10px 14px;
    border-radius: 7px;
    font-size: 14px;
    outline: none;
    font-family: var(--font);
  }
  .nl-form input:focus { border-color: var(--border2); box-shadow: 0 0 0 2px rgba(255,255,255,0.08); }
  .nl-form button {
    background: var(--white);
    color: #000;
    border: none;
    font-weight: 700;
    font-size: 13px;
    padding: 10px 18px;
    border-radius: 7px;
    cursor: pointer;
    font-family: var(--font);
    white-space: nowrap;
    transition: opacity 0.12s;
  }
  .nl-form button:hover { opacity: 0.85; }

  @media (max-width: 980px) {
    .journal-intro,
    .cover-grid,
    .cover-story,
    .field-college-band {
      grid-template-columns: 1fr;
    }
    .cover-copy {
      padding: 24px 0 30px;
    }
    .cover-media {
      min-height: 0;
    }
    .posts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .journal-cover {
      padding: 26px 16px 28px;
    }
    .journal-topline {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
    .journal-intro {
      gap: 18px;
      padding: 24px 0 26px;
    }
    .journal-intro h1 {
      font-size: clamp(2.25rem, 12vw, 3.6rem);
      letter-spacing: -0.045em;
      line-height: 0.98;
    }
    .cover-grid {
      gap: 28px;
      padding-top: 22px;
    }
    .cover-media {
      min-height: 0;
    }
    .cover-copy h2 {
      font-size: clamp(1.65rem, 8.4vw, 2.25rem);
      line-height: 1.06;
      letter-spacing: -0.035em;
    }
    .journal-feed,
    .field-college-band,
    .data-desk-intro {
      padding-left: 16px;
      padding-right: 16px;
    }
    .section-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 16px;
    }
    .cat-filter {
      margin-bottom: 20px;
    }
    .posts-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .college-map {
      grid-template-columns: 44px minmax(0, 1fr);
    }
    .college-stats {
      grid-template-columns: 1fr;
    }
    .college-actions,
    .nl-form {
      flex-direction: column;
    }
    .college-actions a {
      width: 100%;
    }
    .newsletter {
      padding-left: 16px;
      padding-right: 16px;
    }
    .nl-inner {
      padding: 34px 20px;
    }
  }
</style>
