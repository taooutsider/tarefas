---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'ExperimenTAO Wallet is Tao Outsider public Bittensor portfolio experiment, tracking equal weight exposure across active dTAO subnets.';

const walletUrl = 'https://taoswap.org/portfolio/5GLCEsYRq3zTfabT3WsPMetqg5eofRsUgsqPuGgmuZZgjogL';

const principles = [
  {
    label: 'Equal weight first',
    text: 'The point is to observe the whole dTAO field, not to pretend the wallet already knows the winners.',
  },
  {
    label: 'Conviction through exposure',
    text: 'Subnet research changes when the researcher carries the volatility, slippage and bad surprises in public.',
  },
  {
    label: 'TaoSwap execution',
    text: 'Allocations are routed through TaoSwap so the community can inspect the same surface used by the wallet.',
  },
  {
    label: 'Updates over time',
    text: 'Single screenshots are not enough. The value is in monthly changes, winners, laggards and what the market teaches.',
  },
];

const updateFields = [
  'Total wallet value in TAO',
  'Subnets held',
  'Top five performers',
  'Bottom five performers',
  'Largest allocation changes',
  'ROI excluding deposits',
  'Liquidity and slippage notes',
  'What changed in the thesis',
];
---

<BaseLayout
  title="ExperimenTAO Wallet"
  description={description}
  canonicalURL="https://www.taooutsider.com/experimentao-wallet/"
  ogImage="/og-default.jpg"
  ogImageAlt="ExperimenTAO Wallet by Tao Outsider"
>
  <section class="wallet-hero container" data-wallet-page>
    <div class="hero-copy">
      <p class="eyebrow">ExperimenTAO Wallet</p>
      <h1>A public wallet built to study every active Bittensor subnet.</h1>
      <p class="lede">
        ExperimenTAO is Tao Outsider conviction lab. The idea is simple:
        allocate across the field, watch the data, publish the lessons and let the ecosystem teach in public.
      </p>
      <div class="hero-actions">
        <a
          href={walletUrl}
          class="primary-action"
          target="_blank"
          rel="noopener"
          data-conversion-event="experimentao_wallet_open"
          data-conversion-category="wallet"
          data-conversion-label="Open ExperimenTAO on TaoSwap"
        >Open wallet on TaoSwap</a>
        <a href="#live" class="secondary-action">See live data</a>
      </div>
    </div>
    <aside class="wallet-panel" aria-label="ExperimenTAO live snapshot">
      <div class="panel-label" data-wallet-status>Loading live TaoSwap data</div>
      <div class="wallet-address">5GLCE...jogL</div>
      <div class="panel-grid">
        <div>
          <span>Total value</span>
          <strong data-wallet-stat="totalTao">About 6.48T</strong>
          <small data-wallet-note="totalUsd">Fallback snapshot until live data loads.</small>
        </div>
        <div>
          <span>Subnets held</span>
          <strong data-wallet-stat="heldSubnets">126 plus Root</strong>
          <small data-wallet-note="rank">Public wallet across the dTAO field.</small>
        </div>
        <div>
          <span>24h change</span>
          <strong data-wallet-stat="change24h">Loading</strong>
          <small data-wallet-note="change24h">TaoSwap portfolio balance change.</small>
        </div>
        <div>
          <span>30d change</span>
          <strong data-wallet-stat="change30d">Loading</strong>
          <small data-wallet-note="change30d">Measured in TAO and USD.</small>
        </div>
      </div>
    </aside>
  </section>

  <section class="live-dashboard container" id="live" aria-labelledby="live-heading">
    <div class="section-header">
      <div>
        <div class="section-kicker">Live portfolio pulse</div>
        <h2 id="live-heading">ExperimenTAO from TaoSwap data</h2>
      </div>
      <p data-wallet-updated>Waiting for live data.</p>
    </div>

    <div class="dashboard-grid">
      <article class="chart-card">
        <div class="card-head">
          <div>
            <h3>Total wallet value</h3>
            <p>Last 60 daily points, measured in TAO.</p>
          </div>
          <strong data-wallet-stat="chartTotal">Loading</strong>
        </div>
        <svg viewBox="0 0 640 220" role="img" aria-label="ExperimenTAO total wallet value chart">
          <polyline data-wallet-chart points=""></polyline>
        </svg>
        <div class="mini-metrics">
          <span data-wallet-stat="change7d">7d loading</span>
          <span data-wallet-stat="apy30d">30d loading</span>
          <span data-wallet-stat="pnlAll">PnL loading</span>
        </div>
      </article>

      <article class="composition-card">
        <h3>Current composition</h3>
        <div class="composition-list">
          <div>
            <span>Alpha in TAO</span>
            <strong data-wallet-stat="alphaInTao">Loading</strong>
          </div>
          <div>
            <span>Root stake</span>
            <strong data-wallet-stat="rootTao">Loading</strong>
          </div>
          <div>
            <span>Free TAO</span>
            <strong data-wallet-stat="freeTao">Loading</strong>
          </div>
        </div>
      </article>
    </div>

    <div class="leaderboard-grid">
      <article class="leaderboard-card">
        <h3>Top winners</h3>
        <ol data-wallet-winners>
          <li>Loading TaoSwap subnet performance.</li>
        </ol>
      </article>
      <article class="leaderboard-card">
        <h3>Top laggards</h3>
        <ol data-wallet-laggards>
          <li>Loading TaoSwap subnet performance.</li>
        </ol>
      </article>
      <article class="leaderboard-card">
        <h3>Latest activity</h3>
        <ol data-wallet-activity>
          <li>Loading recent wallet activity.</li>
        </ol>
      </article>
    </div>
  </section>

  <section class="principles-band" id="method" aria-labelledby="method-heading">
    <div class="container">
      <div class="section-kicker">How it works</div>
      <h2 id="method-heading">Building conviction in public</h2>
      <div class="principles-grid">
        {principles.map(principle => (
          <article class="principle-card">
            <h3>{principle.label}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="evidence container" aria-labelledby="evidence-heading">
    <div class="evidence-copy">
      <div class="section-kicker">What gets measured</div>
      <h2 id="evidence-heading">The wallet is an evidence engine, not a signal service.</h2>
      <p>
        The goal is not to tell readers which subnet to buy. The goal is to show what broad exposure reveals:
        alpha appreciation, APY traps, slippage, deregistration risk, liquidity depth and the difference between narrative and performance.
      </p>
    </div>
    <div class="bar-list" aria-label="Live performance examples">
      <div class="bar-row">
        <div class="bar-meta">
          <span>All time organic TAO change</span>
          <strong data-wallet-stat="organicAll">Loading</strong>
        </div>
        <div class="bar-track"><span data-wallet-bar="organicAll" style="width: 42%"></span></div>
      </div>
      <div class="bar-row">
        <div class="bar-meta">
          <span>30d TAO value change</span>
          <strong data-wallet-stat="organic30d">Loading</strong>
        </div>
        <div class="bar-track"><span data-wallet-bar="organic30d" style="width: 24%"></span></div>
      </div>
      <div class="bar-row">
        <div class="bar-meta">
          <span>7d TAO value change</span>
          <strong data-wallet-stat="organic7d">Loading</strong>
        </div>
        <div class="bar-track"><span data-wallet-bar="organic7d" style="width: 24%"></span></div>
      </div>
    </div>
  </section>

  <section class="updates container" aria-labelledby="updates-heading">
    <div>
      <div class="section-kicker">Update format</div>
      <h2 id="updates-heading">What every report should include</h2>
      <p>
        The strongest ExperimenTAO posts are data first. The blog version keeps the same discipline with cleaner charts, source notes and a permanent archive.
      </p>
    </div>
    <ol class="update-list">
      {updateFields.map(field => <li>{field}</li>)}
    </ol>
  </section>

  <section class="roadmap container" aria-labelledby="roadmap-heading">
    <div class="roadmap-card">
      <div class="section-kicker">Source trail</div>
      <h2 id="roadmap-heading">Where the live data comes from</h2>
      <p>
        The page reads TaoSwap portfolio, account, transaction and subnet endpoints through a Tao Outsider API layer.
        That lets us keep the public page fast, stable and readable even when a raw upstream field changes.
      </p>
      <a href={walletUrl} target="_blank" rel="noopener">Inspect the source wallet</a>
    </div>
  </section>

  <script>
    const formatTao = (value, digits = 2) => {
      const number = Number(value);
      if (!Number.isFinite(number)) return 'Unavailable';
      return `${number.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits })}T`;
    };

    const formatUsd = (value) => {
      const number = Number(value);
      if (!Number.isFinite(number)) return 'Unavailable';
      return number.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    };

    const formatPct = (value) => {
      const number = Number(value);
      if (!Number.isFinite(number)) return 'Unavailable';
      return `${number > 0 ? '+' : ''}${number.toFixed(2)}%`;
    };

    const signedTao = (value) => {
      const number = Number(value);
      if (!Number.isFinite(number)) return 'Unavailable';
      return `${number > 0 ? '+' : ''}${formatTao(number, Math.abs(number) < 1 ? 3 : 2)}`;
    };

    const dateLabel = (value) => {
      const date = new Date(value);
      if (!Number.isFinite(date.valueOf())) return '';
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
    };

    const setText = (selector, value) => {
      document.querySelectorAll(selector).forEach((item) => {
        item.textContent = value;
      });
    };

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));

    const chartPoints = (rows) => {
      const values = rows.map((item) => Number(item.totalTao)).filter(Number.isFinite);
      if (values.length < 2) return '';
      const min = Math.min(...values);
      const max = Math.max(...values);
      const range = max - min || 1;
      return values.map((value, index) => {
        const x = (index / (values.length - 1)) * 640;
        const y = 210 - ((value - min) / range) * 190;
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      }).join(' ');
    };

    const renderSubnetList = (selector, rows, emptyText) => {
      const root = document.querySelector(selector);
      if (!root) return;
      if (!Array.isArray(rows) || rows.length === 0) {
        root.innerHTML = `<li>${emptyText}</li>`;
        return;
      }
      root.innerHTML = rows.map((row) => `
        <li>
          <span>SN${escapeHtml(row.netuid)} ${escapeHtml(row.name)}</span>
          <strong>${signedTao(row.valueChangeAllTao)}</strong>
          <small>${formatPct(row.apyTaoAll)} TAO APY since tracked</small>
        </li>
      `).join('');
    };

    const renderActivity = (rows) => {
      const root = document.querySelector('[data-wallet-activity]');
      if (!root) return;
      if (!Array.isArray(rows) || rows.length === 0) {
        root.innerHTML = '<li>No recent wallet activity returned.</li>';
        return;
      }
      root.innerHTML = rows.slice(0, 5).map((row) => {
        const target = row.netuid ? `SN${row.netuid}` : 'TAO transfer';
        const amount = row.taoAmount ? formatTao(row.taoAmount, 3) : row.alphaAmount ? `${formatTao(row.alphaAmount, 3)} alpha` : 'amount unavailable';
        return `
          <li>
            <span>${escapeHtml(row.operation)} on ${escapeHtml(target)}</span>
            <strong>${escapeHtml(amount)}</strong>
            <small>${dateLabel(row.timestamp)}</small>
          </li>
        `;
      }).join('');
    };

    const updateBar = (selector, value) => {
      const item = document.querySelector(selector);
      const number = Math.abs(Number(value));
      if (!item || !Number.isFinite(number)) return;
      item.style.width = `${Math.min(100, Math.max(8, number * 32))}%`;
    };

    const hydrateWallet = async () => {
      try {
        const response = await fetch('/api/experimentao-wallet');
        if (!response.ok) throw new Error('Wallet data unavailable.');
        const data = await response.json();
        const overview = data.overview || {};
        const changes = overview.changes || {};
        const pnl = data.pnl || {};

        setText('[data-wallet-status]', `Live from ${data.source}`);
        setText('[data-wallet-updated]', `Data as of ${dateLabel(data.dataAsOf)}`);
        setText('[data-wallet-stat="totalTao"]', formatTao(overview.totalTao));
        setText('[data-wallet-note="totalUsd"]', `${formatUsd(overview.totalUsd)} current TaoSwap value.`);
        setText('[data-wallet-stat="heldSubnets"]', `${overview.heldSubnets || 0}${overview.includesRoot ? ' plus Root' : ''}`);
        setText('[data-wallet-note="rank"]', overview.rank ? `Account rank ${overview.rank.toLocaleString('en-US')}.` : 'Public wallet across the dTAO field.');
        setText('[data-wallet-stat="change24h"]', `${signedTao(changes['24h']?.tao)} ${formatPct(changes['24h']?.taoPct)}`);
        setText('[data-wallet-note="change24h"]', `${formatUsd(changes['24h']?.usd)} in USD terms.`);
        setText('[data-wallet-stat="change30d"]', `${signedTao(changes['30d']?.tao)} ${formatPct(changes['30d']?.taoPct)}`);
        setText('[data-wallet-note="change30d"]', `${formatUsd(changes['30d']?.usd)} in USD terms.`);
        setText('[data-wallet-stat="chartTotal"]', formatTao(overview.totalTao));
        setText('[data-wallet-stat="change7d"]', `7d ${signedTao(changes['7d']?.tao)} ${formatPct(changes['7d']?.taoPct)}`);
        setText('[data-wallet-stat="apy30d"]', `30d TAO APY ${formatPct(pnl.apyTao30d)}`);
        setText('[data-wallet-stat="pnlAll"]', `All time organic ${signedTao(pnl.valueChangeAllTao)}`);
        setText('[data-wallet-stat="alphaInTao"]', formatTao(overview.alphaInTao));
        setText('[data-wallet-stat="rootTao"]', formatTao(overview.rootTao));
        setText('[data-wallet-stat="freeTao"]', formatTao(overview.freeTao));
        setText('[data-wallet-stat="organicAll"]', signedTao(pnl.valueChangeAllTao));
        setText('[data-wallet-stat="organic30d"]', signedTao(pnl.valueChange30dTao));
        setText('[data-wallet-stat="organic7d"]', signedTao(pnl.valueChange7dTao));

        document.querySelector('[data-wallet-chart]')?.setAttribute('points', chartPoints(data.history || []));
        renderSubnetList('[data-wallet-winners]', data.subnets?.winners, 'No winners returned.');
        renderSubnetList('[data-wallet-laggards]', data.subnets?.laggards, 'No laggards returned.');
        renderActivity(data.activity);
        updateBar('[data-wallet-bar="organicAll"]', pnl.valueChangeAllTao);
        updateBar('[data-wallet-bar="organic30d"]', pnl.valueChange30dTao);
        updateBar('[data-wallet-bar="organic7d"]', pnl.valueChange7dTao);
      } catch {
        setText('[data-wallet-status]', 'Static fallback snapshot');
        setText('[data-wallet-updated]', 'Live TaoSwap data is temporarily unavailable.');
      }
    };

    hydrateWallet();
  </script>
</BaseLayout>

<style>
  .wallet-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 36px;
    align-items: center;
    padding: 72px 24px 56px;
  }
  .eyebrow,
  .section-kicker,
  .panel-label {
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .wallet-hero h1 {
    font-size: clamp(2rem, 6vw, 4.1rem);
    max-width: 780px;
    letter-spacing: -0.04em;
    margin-bottom: 18px;
  }
  .lede {
    color: var(--text2);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.75;
    max-width: 720px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }
  .primary-action,
  .secondary-action {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 700;
  }
  .primary-action {
    background: var(--white);
    color: #000;
  }
  .secondary-action {
    border: 1px solid var(--border2);
    color: var(--text);
    background: var(--s1);
  }
  .wallet-panel,
  .roadmap-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0)),
      var(--s1);
    padding: 24px;
  }
  .wallet-address {
    font-family: var(--mono);
    color: var(--white);
    font-size: 1.2rem;
    margin-bottom: 22px;
  }
  .panel-grid {
    display: grid;
    gap: 12px;
  }
  .panel-grid div,
  .composition-list div {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    padding: 14px;
  }
  .panel-grid span,
  .panel-grid small,
  .composition-list span {
    display: block;
    color: var(--muted);
    font-size: 12px;
  }
  .panel-grid strong,
  .composition-list strong {
    display: block;
    color: var(--white);
    font-size: 1.35rem;
    margin: 4px 0;
  }
  .live-dashboard {
    padding: 40px 24px 64px;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 22px;
  }
  .section-header p {
    color: var(--muted);
    font-size: 13px;
  }
  .dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: 18px;
    margin-bottom: 18px;
  }
  .chart-card,
  .composition-card,
  .leaderboard-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--s1);
    padding: 20px;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: start;
    margin-bottom: 16px;
  }
  .card-head h3,
  .composition-card h3,
  .leaderboard-card h3 {
    font-size: 1rem;
    margin-bottom: 4px;
  }
  .card-head p,
  .composition-card p,
  .leaderboard-card small {
    color: var(--muted);
    font-size: 12px;
  }
  .card-head strong {
    color: var(--white);
    font-size: 1rem;
    white-space: nowrap;
  }
  .chart-card svg {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--border);
    border-radius: 10px;
    background:
      repeating-linear-gradient(0deg, transparent, transparent 43px, rgba(255,255,255,0.045) 43px, rgba(255,255,255,0.045) 44px),
      repeating-linear-gradient(90deg, transparent, transparent 63px, rgba(255,255,255,0.045) 63px, rgba(255,255,255,0.045) 64px),
      #050505;
  }
  .chart-card polyline {
    fill: none;
    stroke: var(--white);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mini-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 12px;
  }
  .mini-metrics span {
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text2);
    background: var(--bg);
    font-size: 12px;
    padding: 10px;
  }
  .composition-list {
    display: grid;
    gap: 12px;
  }
  .leaderboard-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .leaderboard-card ol {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .leaderboard-card li {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    padding: 12px;
  }
  .leaderboard-card li span,
  .leaderboard-card li strong,
  .leaderboard-card li small {
    display: block;
  }
  .leaderboard-card li span {
    color: var(--text);
    font-size: 13px;
    line-height: 1.4;
  }
  .leaderboard-card li strong {
    color: var(--white);
    font-size: 1rem;
    margin: 3px 0;
  }
  .principles-band {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--s1);
    padding: 56px 0;
  }
  .principles-band h2,
  .evidence h2,
  .updates h2,
  .roadmap h2 {
    margin-bottom: 16px;
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .principle-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    padding: 18px;
  }
  .principle-card h3 {
    font-size: 1rem;
    margin-bottom: 8px;
  }
  .principle-card p,
  .evidence p,
  .updates p,
  .roadmap-card p {
    color: var(--text2);
    font-size: 14px;
    line-height: 1.75;
  }
  .evidence,
  .updates {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 36px;
    align-items: start;
    padding: 64px 24px 0;
  }
  .bar-list {
    display: grid;
    gap: 16px;
  }
  .bar-row {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--s1);
    padding: 16px;
  }
  .bar-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 12px;
  }
  .bar-meta span {
    color: var(--text2);
    font-size: 13px;
  }
  .bar-meta strong {
    color: var(--white);
  }
  .bar-track {
    height: 8px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }
  .bar-track span {
    display: block;
    height: 100%;
    background: var(--white);
  }
  .update-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .update-list li {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--s1);
    color: var(--text2);
    font-size: 14px;
    padding: 14px;
  }
  .roadmap {
    padding: 64px 24px 0;
    max-width: 860px;
  }
